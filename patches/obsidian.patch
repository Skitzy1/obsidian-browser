diff --git a/ports/servoshell/desktop/browser.rs b/ports/servoshell/desktop/browser.rs
new file mode 100644
index 0000000..f922357
--- /dev/null
+++ b/ports/servoshell/desktop/browser.rs
@@ -0,0 +1,289 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Local desktop preferences. Never stores visited URLs or search history.
+
+use std::fs::{self, OpenOptions};
+use std::io::{Read, Write};
+use std::path::PathBuf;
+
+use serde_json::{Value, json};
+use url::Url;
+
+const MAX_FILE_BYTES: u64 = 8 * 1024 * 1024;
+const MAX_BOOKMARKS: usize = 500;
+
+#[derive(Clone, Debug, PartialEq)]
+pub(super) struct Bookmark {
+    pub title: String,
+    pub url: String,
+}
+
+pub(super) struct BrowserData {
+    pub bookmarks: Vec<Bookmark>,
+    pub show_bookmarks: bool,
+    pub dark_theme: bool,
+    pub settings_open: bool,
+    pub bookmarks_open: bool,
+    pub error: Option<String>,
+    path: Option<PathBuf>,
+    read_only: bool,
+}
+
+impl BrowserData {
+    pub fn load(profile_directory: Option<PathBuf>) -> Self {
+        let path = profile_directory.map(|dir| dir.join("browser.json"));
+        let mut data = Self {
+            bookmarks: Vec::new(),
+            show_bookmarks: true,
+            dark_theme: true,
+            settings_open: false,
+            bookmarks_open: false,
+            error: None,
+            path,
+            read_only: false,
+        };
+        data.reload();
+        data
+    }
+
+    fn reload(&mut self) {
+        let Some(path) = &self.path else { return };
+        let file = match fs::File::open(path) {
+            Ok(file) => file,
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => return,
+            Err(error) => {
+                self.read_only = true;
+                self.error = Some(format!("Could not read browser settings: {error}"));
+                return;
+            },
+        };
+        let mut text = String::new();
+        if let Err(error) = file.take(MAX_FILE_BYTES + 1).read_to_string(&mut text) {
+            self.read_only = true;
+            self.error = Some(format!("Could not read browser settings: {error}"));
+            return;
+        }
+        if text.len() as u64 > MAX_FILE_BYTES {
+            self.read_only = true;
+            self.error = Some("Settings file exceeds the 8 MB limit; left untouched.".into());
+            return;
+        }
+        match serde_json::from_str::<Value>(&text) {
+            Ok(value) if value.is_object() => {
+                self.read_only = false;
+                self.error = None;
+                self.read_value(&value);
+            },
+            _ => {
+                self.read_only = true;
+                self.error = Some("Browser settings are invalid; left untouched.".into());
+            },
+        }
+    }
+
+    fn read_value(&mut self, value: &Value) {
+        self.show_bookmarks = value["show_bookmarks"].as_bool().unwrap_or(true);
+        self.dark_theme = value["dark_theme"].as_bool().unwrap_or(true);
+        self.bookmarks = value["bookmarks"]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .filter_map(|entry| {
+                let url = entry["url"].as_str()?;
+                if !bookmark_url_allowed(url) {
+                    return None;
+                }
+                Some(Bookmark {
+                    title: entry["title"]
+                        .as_str()
+                        .unwrap_or(url)
+                        .chars()
+                        .take(160)
+                        .collect(),
+                    url: url.to_owned(),
+                })
+            })
+            .take(MAX_BOOKMARKS)
+            .collect();
+    }
+
+    fn value(&self) -> Value {
+        json!({
+            "version": 1,
+            "show_bookmarks": self.show_bookmarks,
+            "dark_theme": self.dark_theme,
+            "bookmarks": self.bookmarks.iter().map(|entry| {
+                json!({"title": entry.title, "url": entry.url})
+            }).collect::<Vec<_>>()
+        })
+    }
+
+    pub fn save(&mut self) {
+        // Do not overwrite a corrupt or unreadable file with defaults.
+        if self.read_only {
+            return;
+        }
+        let Some(path) = &self.path else { return };
+        let result = (|| -> std::io::Result<()> {
+            let parent = path
+                .parent()
+                .ok_or_else(|| std::io::Error::other("No settings directory"))?;
+            fs::create_dir_all(parent)?;
+            let nonce = std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .map_err(std::io::Error::other)?
+                .as_nanos();
+            let temporary = path.with_extension(format!("{}.{nonce}.tmp", std::process::id()));
+            let mut options = OpenOptions::new();
+            options.write(true).create_new(true);
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::OpenOptionsExt;
+                options.mode(0o600);
+            }
+            let mut file = options.open(&temporary)?;
+            file.write_all(serde_json::to_string_pretty(&self.value())?.as_bytes())?;
+            file.sync_all()?;
+            fs::rename(temporary, path)?;
+            Ok(())
+        })();
+        if let Err(error) = result {
+            self.error = Some(format!("Could not save browser settings: {error}"));
+        }
+    }
+
+    pub fn contains(&self, url: &str) -> bool {
+        self.bookmarks.iter().any(|entry| entry.url == url)
+    }
+
+    pub fn save_appearance(&mut self) {
+        let dark = self.dark_theme;
+        let bar = self.show_bookmarks;
+        self.reload();
+        self.dark_theme = dark;
+        self.show_bookmarks = bar;
+        self.save();
+    }
+
+    pub fn toggle_bookmark(&mut self, title: &str, url: &str) {
+        if !bookmark_url_allowed(url) {
+            return;
+        }
+        self.reload();
+        if self.read_only {
+            return;
+        }
+        if let Some(index) = self.bookmarks.iter().position(|entry| entry.url == url) {
+            self.bookmarks.remove(index);
+        } else if self.bookmarks.len() < MAX_BOOKMARKS {
+            self.bookmarks.push(Bookmark {
+                title: title.chars().take(160).collect(),
+                url: url.to_owned(),
+            });
+        } else {
+            self.error = Some("Bookmark limit reached (500). Remove a bookmark first.".into());
+            return;
+        }
+        self.save();
+    }
+
+    pub fn remove_bookmark(&mut self, url: &str) {
+        self.reload();
+        self.bookmarks.retain(|entry| entry.url != url);
+        self.save();
+    }
+}
+
+pub(super) fn bookmark_url_allowed(value: &str) -> bool {
+    if value.len() > 8192 {
+        return false;
+    }
+    Url::parse(value).is_ok_and(|url| {
+        matches!(url.scheme(), "https" | "http")
+            && url.host_str().is_some()
+            && url.username().is_empty()
+            && url.password().is_none()
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn temporary_profile(name: &str) -> PathBuf {
+        let nonce = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        std::env::temp_dir().join(format!("obsidian-{name}-{}-{nonce}", std::process::id()))
+    }
+
+    #[test]
+    fn bookmarks_survive_restart_and_other_window_appearance_changes() {
+        let profile = temporary_profile("restart");
+        let mut first = BrowserData::load(Some(profile.clone()));
+        let mut second = BrowserData::load(Some(profile.clone()));
+        first.toggle_bookmark("Example", "https://example.com/");
+        assert!(first.error.is_none());
+        second.dark_theme = false;
+        second.save_appearance();
+        assert!(second.error.is_none());
+        let restored = BrowserData::load(Some(profile.clone()));
+        assert!(!restored.dark_theme);
+        assert!(restored.contains("https://example.com/"));
+        assert_eq!(restored.bookmarks.len(), 1);
+        fs::remove_file(profile.join("browser.json")).unwrap();
+        fs::remove_dir(profile).unwrap();
+    }
+
+    #[test]
+    fn corrupt_settings_are_not_overwritten_even_after_dismissing_error() {
+        let profile = temporary_profile("corrupt");
+        fs::create_dir_all(&profile).unwrap();
+        let path = profile.join("browser.json");
+        fs::write(&path, "{broken").unwrap();
+        let mut data = BrowserData::load(Some(profile.clone()));
+        assert!(data.error.is_some());
+        data.error = None;
+        data.dark_theme = false;
+        data.save();
+        data.toggle_bookmark("Example", "https://example.com/");
+        assert_eq!(fs::read_to_string(&path).unwrap(), "{broken");
+        fs::remove_file(path).unwrap();
+        fs::remove_dir(profile).unwrap();
+    }
+
+    #[test]
+    fn bookmarks_cannot_execute_scripts_or_open_local_files() {
+        for url in [
+            "javascript:alert(1)",
+            "file:///secret",
+            "data:text/html,test",
+            "servo:config",
+            "https://user:password@example.com/",
+        ] {
+            assert!(!bookmark_url_allowed(url), "{url}");
+        }
+        assert!(bookmark_url_allowed(
+            "https://example.com/a?q=hello%20world"
+        ));
+        assert!(bookmark_url_allowed("http://localhost:8080/"));
+    }
+
+    #[test]
+    fn settings_round_trip_and_filter_unsafe_imports() {
+        let mut data = BrowserData::load(None);
+        data.read_value(&json!({"dark_theme": false, "bookmarks": [
+            {"title": "Example", "url": "https://example.com/"},
+            {"title": "Bad", "url": "javascript:alert(1)"}
+        ]}));
+        assert!(!data.dark_theme);
+        assert_eq!(data.bookmarks.len(), 1);
+        let value = data.value();
+        data.read_value(&value);
+        assert_eq!(data.bookmarks[0].title, "Example");
+        assert!(!value.to_string().contains("history"));
+    }
+}
