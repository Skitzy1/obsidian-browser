@@ -0,0 +1,44 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Unprivileged, fixed-resource internal pages. No access to navigator.servo.
+
+use std::future::Future;
+use std::pin::Pin;
+
+use servo::protocol_handler::{
+    DoneChannel, FetchContext, NetworkError, ProtocolHandler, Request, Response,
+};
+
+use super::resource::ResourceProtocolHandler;
+
+#[derive(Default)]
+pub struct ObsidianProtocolHandler;
+
+impl ProtocolHandler for ObsidianProtocolHandler {
+    fn load(
+        &self,
+        request: &mut Request,
+        done_chan: &mut DoneChannel,
+        context: &FetchContext,
+    ) -> Pin<Box<dyn Future<Output = Response> + Send>> {
+        match request.current_url().path() {
+            "newtab" => ResourceProtocolHandler::response_for_path(
+                request,
+                done_chan,
+                context,
+                "/obsidian-newtab.html",
+            ),
+            "about" => ResourceProtocolHandler::response_for_path(
+                request,
+                done_chan,
+                context,
+                "/obsidian-about.html",
+            ),
+            _ => Box::pin(std::future::ready(Response::network_error(
+                NetworkError::ResourceLoadError("Unknown Obsidian page".into()),
+            ))),
+        }
+    }
+}
