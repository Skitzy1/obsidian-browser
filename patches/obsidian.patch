+fn apply_browser_theme(ctx: &egui::Context, dark: bool) {
+    ctx.set_theme(if dark {
+        egui::Theme::Dark
+    } else {
+        egui::Theme::Light
+    });
+    let mut visuals = if dark {
+        egui::Visuals::dark()
+    } else {
+        egui::Visuals::light()
+    };
+    visuals.selection.bg_fill = egui::Color32::from_rgb(92, 52, 122);
+    visuals.selection.stroke.color = egui::Color32::WHITE;
+    visuals.panel_fill = if dark {
+        egui::Color32::from_rgb(24, 19, 33)
+    } else {
+        egui::Color32::from_rgb(245, 241, 250)
+    };
+    ctx.set_visuals(visuals);
+}
+
+fn draw_browser_actions(
+    ui: &mut egui::Ui,
+    browser: &mut BrowserData,
+    state: &RunningAppState,
+    window: &ServoShellWindow,
+) {
+    ui.menu_button("☰", |ui| {
+        ui.set_min_width(230.0);
+        ui.strong("Obsidian");
+        ui.separator();
+        if ui.add(egui::Button::new("New tab").shortcut_text("Ctrl+T")).clicked() {
+            window.queue_user_interface_command(UserInterfaceCommand::NewWebView);
+            ui.close();
+        }
+        if ui.button("Bookmarks").clicked() {
+            browser.bookmarks_open = true;
+            ui.close();
+        }
+        if ui.button("Settings & privacy").clicked() {
+            browser.settings_open = true;
+            ui.close();
+        }
+        if ui.button("About Obsidian").clicked() {
+            window.queue_user_interface_command(UserInterfaceCommand::Go("obsidian:about".into()));
+            ui.close();
+        }
+        ui.separator();
+        ui.horizontal(|ui| {
+            ui.label("Zoom");
+            if let Some(view) = window.active_webview() {
+                if ui.button("−").clicked() {
+                    view.set_page_zoom((view.page_zoom() / 1.1).max(0.3));
+                }
+                if ui
+                    .button(format!("{:.0}%", view.page_zoom() * 100.0))
+                    .clicked()
+                {
+                    view.set_page_zoom(1.0);
+                }
+                if ui.button("+").clicked() {
+                    view.set_page_zoom((view.page_zoom() * 1.1).min(5.0));
+                }
+            }
+        });
+        ui.separator();
+        if ui.button("Quit").clicked() {
+            state.schedule_exit();
+        }
+    });
+
+    if let Some(view) = window.active_webview()
+        && let Some(url) = view.url()
+    {
+        let url = url.as_str();
+        let starred = browser.contains(url);
+        if ui
+            .add_enabled(
+                bookmark_url_allowed(url),
+                Gui::toolbar_button(if starred { "★" } else { "☆" }),
+            )
+            .on_hover_text(if starred {
+                "Remove bookmark"
+            } else {
+                "Bookmark this page · Ctrl+D"
+            })
+            .clicked()
+        {
+            browser.toggle_bookmark(&view.page_title().unwrap_or_else(|| url.to_owned()), url);
+        }
+    }
+
+    let connection = window.active_webview().and_then(|view| view.url());
+    let (badge, description) = match connection.as_ref().map(|url| url.scheme()) {
+        Some("https") => (
+            "HTTPS",
+            "Encrypted connection. This does not guarantee that a website is trustworthy.",
+        ),
+        Some("http") => (
+            "HTTP",
+            "This connection is not encrypted. Avoid entering passwords or private information.",
+        ),
+        Some("obsidian" | "servo" | "resource" | "about") => ("Local", "Built-in browser page."),
+        Some("file") => ("File", "A file on this device."),
+        _ => (
+            "Page",
+            "Check the full address before entering sensitive information.",
+        ),
+    };
+    ui.small(badge).on_hover_text(description);
+}
+
+fn draw_browser_windows(ctx: &egui::Context, browser: &mut BrowserData, window: &ServoShellWindow) {
+    let mut save_settings = false;
+    egui::Window::new("Settings & privacy")
+        .open(&mut browser.settings_open)
+        .default_width(480.0)
+        .resizable(false)
+        .show(ctx, |ui| {
+            ui.heading("Appearance");
+            ui.add_space(12.0);
+            save_settings |= ui.checkbox(&mut browser.show_bookmarks, "Show bookmarks bar").changed();
+            if ui.checkbox(&mut browser.dark_theme, "Dark appearance").changed() {
+                apply_browser_theme(ctx, browser.dark_theme);
+                save_settings = true;
+            }
+            ui.add_space(12.0);
+            ui.separator();
+            ui.strong("Search");
+            ui.label("Brave Search · Brave receives searches when you submit them.");
+            ui.label("The address bar does not request remote suggestions.");
+            ui.add_space(12.0);
+            ui.strong("On this device");
+            ui.label("Bookmarks and appearance settings are saved locally.");
+            ui.label("Obsidian adds no browsing-history database or account sync.");
+            ui.label("Websites can still store cookies and site data through Servo.");
+            ui.add_space(12.0);
+            ui.strong("Development status");
+            ui.label("Tracker blocking and fingerprinting protection are not implemented.");
+            if cfg!(target_os = "windows") {
+                ui.colored_label(egui::Color32::from_rgb(235, 180, 110),
+                    "This Servo version has no Windows renderer sandbox. Use this preview for development only.");
+            } else {
+                ui.label("The Linux launcher requests multiprocess sandboxing. It still needs runtime verification.");
+            }
+            ui.add_space(12.0);
+            ui.weak("Obsidian 0.1 · Servo engine · Open source");
+        });
+    if save_settings {
+        browser.save_appearance();
+    }
+
+    let mut remove = None;
+    egui::Window::new("Bookmarks")
+        .open(&mut browser.bookmarks_open)
+        .default_width(520.0)
+        .show(ctx, |ui| {
+            if browser.bookmarks.is_empty() {
+                ui.label("No bookmarks yet. Open a website and select the star in the toolbar.");
+            }
+            egui::ScrollArea::vertical()
+                .max_height(420.0)
+                .show(ui, |ui| {
+                    for entry in &browser.bookmarks {
+                        ui.horizontal(|ui| {
+                            if ui
+                                .button(truncate_with_ellipsis(&entry.title, 42))
+                                .on_hover_text(&entry.url)
+                                .clicked()
+                            {
+                                window.queue_user_interface_command(UserInterfaceCommand::Go(
+                                    entry.url.clone(),
+                                ));
+                            }
+                            if ui.small_button("Remove").clicked() {
+                                remove = Some(entry.url.clone());
+                            }
+                        });
+                        ui.weak(&entry.url);
+                        ui.separator();
+                    }
+                });
+        });
+    if let Some(url) = remove {
+        browser.remove_bookmark(&url);
+    }
+
+    if let Some(error) = browser.error.clone() {
+        let mut dismiss = false;
+        egui::Window::new("Local settings could not be saved")
+            .collapsible(false)
+            .show(ctx, |ui| {
+                ui.label(error);
+                ui.label("Your existing settings file has been preserved. Restart after fixing the file or disk space.");
+                dismiss = ui.button("Dismiss").clicked();
+            });
+        if dismiss {
+            browser.error = None;
+        }
+    }
+}
